# Noir Stan Awards '26 Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit your real .env.local or production secrets to Git!

# Supabase PostgreSQL Configuration
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY server-side only! Never expose to browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Authentication
# Secure passphrase or token used to log in to /admin organizer dashboard
ADMIN_SECRET=noir_admin_secret_2026_change_in_production

# Optional Anti-Abuse CAPTCHA (Cloudflare Turnstile or Google reCAPTCHA)
# Leave blank to run in permissive testing mode (rate-limiting still enforced server-side)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# App URL for sharing and OpenGraph metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
